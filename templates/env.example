# 环境变量示例 —— 复制成本地 .env 或 export 后再填真实值，⛔ 本文件只放占位符，勿填真实密钥

# ── audio.cpp 服务（ACE-Step / ASR / TTS / CosyVoice / HTDemucs / ForcedAligner）──
AUDIOCPP_HOST=<服务地址，不填默认>
AUDIOCPP_PORT=<端口，不填默认>

# ── 擂台 LLM 通道的密钥（按实际用的模型/平台填，key 绝不上传）──
# 示例占位，实际键名以本地 .env 为准：
# LLM_API_KEY=<your-api-key>
# ARK_API_KEY=<your-api-key>

# ── 其它开关 ──
# LLM_FAST=0            # 1=快速模式（省 token，质量略降）
# BAILIAN_CONCURRENCY=1 # 限流并发
# ARK_CONCURRENCY=3

# ── 本地作品归档（可选；真实目录仅在本地配置）──
# WORKSPACE_DIR=/path/to/workspace
# TOOLS_DIR=/path/to/tools              # 其中 release_meta.py 提供本地 SONGS 列表
# MUSIC_LIBRARY_DIR=/path/to/library
# EVIDENCE_OUT=/path/to/evidence

# ── Wan独立客户端：环境变量优先，也可使用本地 ~/.dsh/secrets/asr_models.env ──
# ASR_MODEL_API_KEY=<your-api-key>
# ASR_MODEL_BASE_URL=https://example.invalid/api/v1
# VISION_MODEL_S2V_NAME=wan2.2-s2v
# VISION_MODEL_VIDEO_NAME=wan3.0-video-prime
